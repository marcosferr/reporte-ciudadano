---
import "../styles/global.css";
import { safeJson } from "../lib/format";
import { config } from "../lib/server/config";

interface Props {
  title: string;
  description?: string;
  image?: string | null;
  noindex?: boolean;
  jsonLd?: object | object[];
  /** Mapa a pantalla completa: sin footer, sin scroll del body. */
  fullscreen?: boolean;
  active?: "mapa" | "reportar" | "estadisticas" | "zonas" | "mis";
}

const {
  title,
  description = "Reportá baches, raudales, inseguridad, basurales y más problemas de tu ciudad. Mapa abierto con seguimiento de cada caso en todo Paraguay.",
  image,
  noindex = false,
  jsonLd,
  fullscreen = false,
  active,
} = Astro.props;

const siteName = "Reporte Ciudadano";
const fullTitle = title === siteName ? `${siteName} · Problemas de tu ciudad en el mapa` : `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, config.siteUrl).toString();
const ogImage = new URL(image ?? "/og-default.png", config.siteUrl).toString();
const user = Astro.locals.user;

const nav = [
  { key: "mapa", href: "/", label: "Mapa", icon: "M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" },
  { key: "zonas", href: "/py", label: "Zonas", icon: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z" },
  { key: "reportar", href: "/reportar", label: "Reportar", icon: "M12 4v16m8-8H4" },
  { key: "estadisticas", href: "/estadisticas", label: "Datos", icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" },
  { key: "mis", href: "/mis-reportes", label: "Mis casos", icon: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" },
] as const;
---
<!doctype html>
<html lang="es-PY">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0f6b55" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..800&family=Inter:wght@400..700&display=swap" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Reporte" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_PY" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={safeJson(jsonLd)} />}
    <slot name="head" />
  </head>
  <body class:list={[fullscreen ? "h-dvh overflow-hidden" : "min-h-dvh pb-20 md:pb-0"]}>
    <header class="sticky top-0 z-30 border-b border-sand-200 bg-white/85 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-6xl items-center gap-3 px-4">
        <a href="/" class="font-display flex items-center gap-2 text-[1.05rem] font-extrabold tracking-tight text-ink">
          <img src="/icon.svg" alt="" width="28" height="28" />
          <span>Reporte<span class="text-brand-600">Ciudadano</span></span>
        </a>
        <nav class="ml-6 hidden gap-1 md:flex" aria-label="Principal">
          {nav.filter((n) => n.key !== "reportar").map((n) => (
            <a href={n.href} class:list={["rounded-lg px-3 py-2 text-sm font-semibold", active === n.key ? "bg-brand-50 text-brand-700" : "text-slate-600 hover:bg-slate-100"]}>{n.label}</a>
          ))}
          {user?.isStaff && <a href="/admin" class="rounded-lg px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-100">Admin</a>}
        </nav>
        <div class="ml-auto flex items-center gap-2">
          <a href="/reportar" class="btn-alert hidden py-2 text-sm md:inline-flex">+ Reportar</a>
          {user ? (
            <details class="relative">
              <summary class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-full bg-brand-100 font-bold text-brand-700" aria-label="Cuenta">
                {(user.name ?? user.email).charAt(0).toUpperCase()}
              </summary>
              <div class="card absolute right-0 mt-2 w-56 p-2 text-sm">
                <p class="truncate px-2 py-1 text-slate-500">{user.email}</p>
                <a class="block rounded-lg px-2 py-2 hover:bg-slate-50" href="/mis-reportes">Mis reportes</a>
                <a class="block rounded-lg px-2 py-2 hover:bg-slate-50" href="/mis-reportes#ciudad">Mi ciudad</a>
                {user.isStaff && <a class="block rounded-lg px-2 py-2 hover:bg-slate-50" href="/admin">Panel de gestión</a>}
                <form method="post" action="/auth/logout">
                  <button type="submit" class="block w-full rounded-lg px-2 py-2 text-left text-alert-600 hover:bg-slate-50">Salir</button>
                </form>
              </div>
            </details>
          ) : (
            <a href={`/ingresar?next=${encodeURIComponent(Astro.url.pathname)}`} class="rounded-lg px-3 py-2 text-sm font-semibold text-brand-700 hover:bg-brand-50">Ingresar</a>
          )}
        </div>
      </div>
    </header>

    <main class:list={[fullscreen ? "relative h-[calc(100dvh-3.5rem-4.25rem-env(safe-area-inset-bottom))] md:h-[calc(100dvh-3.5rem)]" : ""]}>
      <slot />
    </main>

    {!fullscreen && (
      <footer class="mt-12 border-t border-sand-200 bg-white">
        <div class="mx-auto grid max-w-6xl gap-6 px-4 py-8 text-sm text-slate-600 sm:grid-cols-3">
          <div>
            <p class="font-display font-extrabold text-ink">Reporte Ciudadano</p>
            <p class="mt-1">Mapa abierto de problemas urbanos de Paraguay, hecho por y para la ciudadanía.</p>
          </div>
          <ul class="space-y-1">
            <li><a class="hover:underline" href="/py">Reportes por departamento</a></li>
            <li><a class="hover:underline" href="/estadisticas">Estadísticas</a></li>
            <li><a class="hover:underline" href="/datos-abiertos">Datos abiertos</a></li>
          </ul>
          <ul class="space-y-1">
            <li><a class="hover:underline" href="/acerca">Acerca de</a></li>
            <li><a class="hover:underline" href="/privacidad">Privacidad</a></li>
            <li><a class="hover:underline" href="/terminos">Términos de uso</a></li>
          </ul>
        </div>
        <p class="pb-6 text-center text-xs text-slate-400">Límites administrativos: DGEEC vía geoBoundaries (CC BY 4.0) · Mapa: OpenFreeMap, © OpenStreetMap</p>
      </footer>
    )}

    <nav class="safe-bottom fixed inset-x-0 bottom-0 z-40 border-t border-sand-200 bg-white md:hidden" aria-label="Navegación">
      <ul class="grid grid-cols-5">
        {nav.map((n) => (
          <li>
            {n.key === "reportar" ? (
              <a href={n.href} class="flex flex-col items-center py-1.5 text-[11px] font-semibold text-alert-600">
                <span class="-mt-5 flex h-12 w-12 items-center justify-center rounded-full bg-alert-500 text-white shadow-lg ring-4 ring-white">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={n.icon} /></svg>
                </span>
                {n.label}
              </a>
            ) : (
              <a href={n.href} aria-current={active === n.key ? "page" : undefined} class:list={["flex flex-col items-center gap-0.5 py-2 text-[11px] font-semibold", active === n.key ? "text-brand-600" : "text-slate-500"]}>
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={n.icon} /></svg>
                {n.label}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <script>
      import { flushOutbox } from "../lib/client/outbox";
      if ("serviceWorker" in navigator && location.hostname !== "localhost") {
        navigator.serviceWorker.register("/sw.js").catch(() => {});
      }
      // Reportes guardados sin conexión se envían al volver la señal.
      flushOutbox();
      window.addEventListener("online", () => flushOutbox());
    </script>
  </body>
</html>
