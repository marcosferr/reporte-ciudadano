---
/** Selector de tema (Sistema / Claro / Oscuro). El ícono del botón se elige con CSS según <html data-theme>. */
const icons = {
  system: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  light: "M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z",
  dark: "M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z",
};
const options = [
  { value: "system", label: "Sistema" },
  { value: "light", label: "Claro" },
  { value: "dark", label: "Oscuro" },
] as const;
---
<details class="theme-toggle relative" data-menu>
  <summary class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-full text-fg-muted hover:bg-surface-2 hover:text-fg" aria-label="Tema de colores">
    {options.map((o) => (
      <svg class:list={["theme-icon h-5 w-5", `theme-icon-${o.value}`]} fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={icons[o.value]} /></svg>
    ))}
  </summary>
  <div class="popover absolute right-0 z-40 mt-2 w-40 p-1 text-sm" role="group" aria-label="Tema de colores">
    {options.map((o) => (
      <button type="button" data-theme-choice={o.value} aria-pressed="false"
        class="flex w-full items-center gap-2 rounded-lg px-2 py-2 text-left text-fg-muted hover:bg-surface-2 aria-pressed:font-semibold aria-pressed:text-accent">
        <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={icons[o.value]} /></svg>
        {o.label}
      </button>
    ))}
  </div>
</details>

<style>
  .theme-icon { display: none; }
  :global(html:not([data-theme])) .theme-icon-system,
  :global(html[data-theme="light"]) .theme-icon-light,
  :global(html[data-theme="dark"]) .theme-icon-dark { display: block; }
</style>

<script>
  import { applyTheme, readTheme, syncThemeColor, THEME_KEY, type ThemeChoice } from "../lib/client/theme";

  const toggle = document.querySelector<HTMLDetailsElement>(".theme-toggle");
  const summary = toggle?.querySelector<HTMLElement>("summary") ?? null;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-theme-choice]")];

  function render(choice: ThemeChoice) {
    for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.themeChoice === choice));
  }

  const initial = readTheme();
  render(initial);
  syncThemeColor(initial);
  for (const b of buttons) {
    b.addEventListener("click", () => {
      const choice = b.dataset.themeChoice as ThemeChoice;
      applyTheme(choice, { save: true });
      render(choice);
      // Al cerrar el menú el foco se va al <body>, y quien navega con el teclado pierde el sitio.
      // Devolverlo al summary deja el botón listo para la siguiente tecla.
      if (toggle) toggle.open = false;
      summary?.focus();
    });
  }
  // Otra pestaña cambió el tema.
  window.addEventListener("storage", (e) => {
    if (e.key !== THEME_KEY) return;
    const choice = readTheme();
    applyTheme(choice);
    render(choice);
  });
</script>
